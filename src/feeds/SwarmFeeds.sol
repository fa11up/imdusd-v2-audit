pragma solidity 0.8.26;

import {SwarmFeed} from "./SwarmFeed.sol";

/// @notice The question documents of v1's three live IMD feeds, byte for byte. Copied from the imdUSD v1 source at tag
/// `mainnet-freeze-2026-10-11` (b2c7afe): PriceFeed.sol, SpotFeed.sol, NhiFeed.sol (`QUESTION_PREFIX` and the span
/// bounds of each `questionPolicy`). The question is about Ethereum mainnet (`"chainId":1`); the CONSUMER (chain id and
/// feed address) is in the EIP-712 domain, not in the question, so a feed on Robinhood Chain pins the same prefix and
/// accepts answers to the same mainnet question bought for it as consumer. Never hand-edit: a one-character change refuses
/// every attestation. test/unit/SwarmFeed.t.sol and the fork test check these against v1's live feeds' `expectedQuestionHash`.
library SwarmQuestions {
    bytes internal constant PRICE = hex"";
    uint64 internal constant PRICE_MIN_SPAN = 300;
    uint64 internal constant PRICE_MAX_SPAN = 1_200;
    bytes internal constant SPOT = hex"";
    uint64 internal constant SPOT_MIN_SPAN = 150;
    uint64 internal constant SPOT_MAX_SPAN = 1_200;
    bytes internal constant NHI = hex"";
    uint64 internal constant NHI_MIN_SPAN = 150;
    uint64 internal constant NHI_MAX_SPAN = 1_200;

    /// @dev The seat type's two questions (recipe `nft-sale-median`, plane PR #701), generated
    /// from the plane's own questionDocument + canonical JSON.
    /// FROZEN: the two question prefixes below are the only questions these feeds take (each is bound by hash). Median: 7-day (168 h) p25 of each seat's latest sale; figure = distinct seats sold. Spot: 1-day (24 h)
    /// median of the last five seats' sales, capped by the two strategies' lowest live ask; figure = distinct seats sold.
    bytes internal constant SEAT_MEDIAN = hex"";
    uint64 internal constant SEAT_MEDIAN_MIN_SPAN = 45_000; // 168 h resolved to 50,239 blocks on 2026-10-26
    uint64 internal constant SEAT_MEDIAN_MAX_SPAN = 55_000;
    bytes internal constant SEAT_SPOT = hex"";
    uint64 internal constant SEAT_SPOT_MIN_SPAN = 6_500; // 24 h is ~7,200 blocks
    uint64 internal constant SEAT_SPOT_MAX_SPAN = 8_000;

    /// @dev The IMD depth leg's question (recipe `univ4-depth`, plane branch recipe/univ4-depth), generated
    /// from the plane's own questionDocument + canonical JSON, and FROZEN. The smallest ETH (wei) the v4 ETH/IMD pool 0xb07d pays a seller of
    /// IMD before IMD falls 15% (bandBps 1765 = a 17.65% rise of the pool's ETH price in IMD), over 13 blocks of a 24-hour
    /// window; figure = blocks read. REGENERATE if the recipe's canonical form changes before the plane merges it.
    bytes internal constant IMD_DEPTH = hex"";
    uint64 internal constant IMD_DEPTH_MIN_SPAN = 6_500; // 24 h is ~7,200 blocks
    uint64 internal constant IMD_DEPTH_MAX_SPAN = 8_000;

    /// @dev v1 DeploymentConfig at the same tag: the plane's oracle signer and its answer type for a uint256.
    address internal constant ATTESTER = 0x5598Aa9146215Bc13eb26f2c692Ad1461Fd32982;
    uint8 internal constant ANSWER_TYPE = 3;
    uint256 internal constant DATA_CHAIN = 1;
}

/// @notice The question binding of each leaf, separate from its signer so tests can sign as a test attester while the
/// question stays the production one.
abstract contract SwarmPricePolicy is SwarmFeed {
    /// @dev v1 PriceFeed: a deterministic chain read, so two thirds of the 100-member panel.
    function minAgreed() public pure override returns (uint16) {
        return 67;
    }

    function questionPolicy() internal pure override returns (bytes memory, uint64, uint64) {
        return (SwarmQuestions.PRICE, SwarmQuestions.PRICE_MIN_SPAN, SwarmQuestions.PRICE_MAX_SPAN);
    }
}

abstract contract SwarmSpotPolicy is SwarmFeed {
    function minAgreed() public pure override returns (uint16) {
        return 67;
    }

    function questionPolicy() internal pure override returns (bytes memory, uint64, uint64) {
        return (SwarmQuestions.SPOT, SwarmQuestions.SPOT_MIN_SPAN, SwarmQuestions.SPOT_MAX_SPAN);
    }
}

abstract contract SwarmNhiPolicy is SwarmFeed {
    function questionPolicy() internal pure override returns (bytes memory, uint64, uint64) {
        return (SwarmQuestions.NHI, SwarmQuestions.NHI_MIN_SPAN, SwarmQuestions.NHI_MAX_SPAN);
    }
}

/// @notice IMD/ETH median (wei of ETH per 1e18 IMD) over a mainnet window, for any consumer chain. Signer, answer type and
/// data chain are source constants; the relay is permissionless (zero relayer: the question is bound, so the relayer is
/// not a trust boundary, v1's rule). Only the lifetime and the per-epoch cap differ between deployments.
contract SwarmPriceFeed is SwarmPricePolicy {
    constructor(uint256 maxAge_, uint256 maxDeviationBps_)
        SwarmFeed(SwarmQuestions.ATTESTER, address(0), SwarmQuestions.DATA_CHAIN, SwarmQuestions.ANSWER_TYPE, maxAge_, maxDeviationBps_)
    {}
}

/// @notice IMD/ETH spot at the window's last block (v1 SpotFeed's question).
contract SwarmSpotFeed is SwarmSpotPolicy {
    constructor(uint256 maxAge_, uint256 maxDeviationBps_)
        SwarmFeed(SwarmQuestions.ATTESTER, address(0), SwarmQuestions.DATA_CHAIN, SwarmQuestions.ANSWER_TYPE, maxAge_, maxDeviationBps_)
    {}
}

/// @notice The IMD network health index (v1 NhiFeed's question).
contract SwarmNhiFeed is SwarmNhiPolicy {
    constructor(uint256 maxAge_, uint256 maxDeviationBps_)
        SwarmFeed(SwarmQuestions.ATTESTER, address(0), SwarmQuestions.DATA_CHAIN, SwarmQuestions.ANSWER_TYPE, maxAge_, maxDeviationBps_)
    {}
}

/// @notice A seat feed: the answer is a price, and the signed figure is a SECOND number, the distinct seats sold in the
/// window (the recipe's depth). It is kept beside the value, from the same attestation, so a reader never pairs a price
/// with another attestation's count. SwarmFeed's minimum agreement (51 of a panel of at least 100) applies.
abstract contract SwarmSeatFeed is SwarmFeed {
    uint256 internal _figure;

    /// @notice The distinct seats sold in the accepted attestation's window (a plain count, not 1e18-scaled).
    function latestFigure() external view returns (uint256) {
        return _figure;
    }

    function _onFigure(uint256 figure, uint256) internal override {
        _figure = figure;
    }
}

abstract contract SwarmSeatMedianPolicy is SwarmSeatFeed {
    function questionPolicy() internal pure override returns (bytes memory, uint64, uint64) {
        return (SwarmQuestions.SEAT_MEDIAN, SwarmQuestions.SEAT_MEDIAN_MIN_SPAN, SwarmQuestions.SEAT_MEDIAN_MAX_SPAN);
    }
}

abstract contract SwarmSeatSpotPolicy is SwarmSeatFeed {
    function questionPolicy() internal pure override returns (bytes memory, uint64, uint64) {
        return (SwarmQuestions.SEAT_SPOT, SwarmQuestions.SEAT_SPOT_MIN_SPAN, SwarmQuestions.SEAT_SPOT_MAX_SPAN);
    }
}

/// @notice The seat's 7-day p25 sale price, wei of ETH per seat (the SeatFeed median leg); figure = sales7d.
contract SwarmSeatMedianFeed is SwarmSeatMedianPolicy {
    constructor(uint256 maxAge_, uint256 maxDeviationBps_)
        SwarmFeed(SwarmQuestions.ATTESTER, address(0), SwarmQuestions.DATA_CHAIN, SwarmQuestions.ANSWER_TYPE, maxAge_, maxDeviationBps_)
    {}
}

/// @notice The seat's 1-day spot, wei of ETH per seat (the SeatFeed spot leg); figure = seats sold that day.
contract SwarmSeatSpotFeed is SwarmSeatSpotPolicy {
    constructor(uint256 maxAge_, uint256 maxDeviationBps_)
        SwarmFeed(SwarmQuestions.ATTESTER, address(0), SwarmQuestions.DATA_CHAIN, SwarmQuestions.ANSWER_TYPE, maxAge_, maxDeviationBps_)
    {}
}

/// @notice The swarm's second IMD-depth leg: the smallest wei of ETH the ETH/IMD v4 pool pays a seller of IMD
/// before IMD falls 15%, attested over a 24-hour window. The signed figure is the number of blocks read (a count, kept
/// beside the value); the value is a quantity, so the epoch deviation rule bounds it. ImdDepth converts it to USD with
/// the ETH price and takes min(on-chain sampler sum, this) once the Safe has configured it.
contract SwarmImdDepthFeed is SwarmFeed {
    uint256 internal _figure;

    constructor(uint256 maxAge_, uint256 maxDeviationBps_)
        SwarmFeed(SwarmQuestions.ATTESTER, address(0), SwarmQuestions.DATA_CHAIN, SwarmQuestions.ANSWER_TYPE, maxAge_, maxDeviationBps_)
    {}

    /// @notice The blocks the accepted attestation's panel read (a plain count).
    function latestFigure() external view returns (uint256) {
        return _figure;
    }

    function _onFigure(uint256 figure, uint256) internal override {
        _figure = figure;
    }

    function questionPolicy() internal pure override returns (bytes memory, uint64, uint64) {
        return (SwarmQuestions.IMD_DEPTH, SwarmQuestions.IMD_DEPTH_MIN_SPAN, SwarmQuestions.IMD_DEPTH_MAX_SPAN);
    }
}
